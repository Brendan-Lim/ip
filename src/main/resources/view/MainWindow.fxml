<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.AmbientLight?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.paint.Color?>

<VBox xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="habpyduck.ui.MainWindow">
    <ScrollPane fx:id="scrollPane" fitToWidth="true" VBox.vgrow="ALWAYS">
        <content>
            <VBox fx:id="dialogContainer" spacing="8">
                <padding>
                    <Insets bottom="10" left="10" right="10" top="10" />
                </padding>
            </VBox>
        </content>
    </ScrollPane>
   <AmbientLight lightOn="true">
      <color>
         <Color red="0.3173646926879883" green="0.3199999928474426" blue="0.08320000022649765" />
      </color>
   </AmbientLight>
    <HBox spacing="8">
        <padding>
            <Insets bottom="10" left="10" right="10" top="10" />
        </padding>
        <TextField fx:id="userInput" onAction="#handleUserInput" promptText="Talk to me!" HBox.hgrow="ALWAYS" />
        <Button defaultButton="true" onAction="#handleUserInput" text="Send" />
    </HBox>
</VBox>
